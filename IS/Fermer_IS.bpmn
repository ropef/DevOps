<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Farm_EDO" targetNamespace="http://example.com/farm/edo" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_Farm">
    <bpmn:participant id="Participant_Farm" name="ИС фермерское хозяйство" processRef="Process_Farm" />
    <bpmn:participant id="Participant_Supplier" name="Поставщик" />
    <bpmn:participant id="Participant_Buyer" name="Покупатель" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Farm" name="Управление растениеводческим хозяйством с электронным документооборотом" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Farm">
      <bpmn:lane id="Lane_Accountant" name="Бухгалтер">
        <bpmn:flowNodeRef>Task_SendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSaleDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipProduct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storekeeper" name="Кладовщик (Склад)">
        <bpmn:flowNodeRef>Task_ReceiveDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmHarvest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Worker" name="Работник">
        <bpmn:flowNodeRef>Task_PerformFieldWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Harvest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="ЭДО">
        <bpmn:flowNodeRef>Task_RegisterPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterPurchaseRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterHarvest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateHarvestStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterSaleRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateSaleDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveDocs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agronomist" name="Агроном">
        <bpmn:flowNodeRef>Task_CreatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnoughResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanFieldWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ControlCrops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CropsReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateHarvestReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateSaleRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePurchaseRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Руководитель">
        <bpmn:flowNodeRef>Start_Season</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PurchaseApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveSale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovePurchase</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Season" name="Начало сезона" />
    <bpmn:task id="Task_CreatePlan" name="Составить план посевов и работ" />
    <bpmn:task id="Task_ApprovePlan" name="Согласовать план в системе" />
    <bpmn:task id="Task_RegisterPlan" name="Зарегистрировать план и сохранить версию" />
    <bpmn:task id="Task_CheckStock" name="Проверить остатки семян, удобрений и топлива" />
    <bpmn:exclusiveGateway id="Gateway_EnoughResources" name="Ресурсов достаточно?" />
    <bpmn:task id="Task_RegisterPurchaseRequest" name="Зарегистрировать заявку, присвоить номер и статус" />
    <bpmn:exclusiveGateway id="Gateway_PurchaseApproved" name="Заявка согласована?" />
    <bpmn:task id="Task_GenerateOrder" name="Сформировать электронный заказ поставщику" />
    <bpmn:task id="Task_SendOrder" name="Отправить заказ поставщику">
      <bpmn:outgoing>Flow_1y7zecu</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveOrder" name="Получить электронный заказ">
      <bpmn:incoming>Flow_1y7zecu</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_DeliverResources" name="Подготовить и доставить ресурсы">
      <bpmn:outgoing>Flow_1eetfak</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveDelivery" name="Принять поставку и сверить количество">
      <bpmn:incoming>Flow_1eetfak</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmAcceptance" name="Подтвердить приёмку электронной отметкой" />
    <bpmn:task id="Task_RegisterAcceptance" name="Создать электронный акт приёмки и прикрепить накладную" />
    <bpmn:task id="Task_UpdateStock" name="Автоматически обновить складские остатки" />
    <bpmn:task id="Task_PlanFieldWork" name="Назначить полевые работы" />
    <bpmn:task id="Task_PerformFieldWork" name="Подготовить почву, посеять и ухаживать за культурами" />
    <bpmn:task id="Task_RegisterWork" name="Зафиксировать выполненные работы в электронном журнале" />
    <bpmn:task id="Task_ControlCrops" name="Проверить состояние посевов" />
    <bpmn:exclusiveGateway id="Gateway_CropsReady" name="Урожай готов к сбору?" />
    <bpmn:task id="Task_Harvest" name="Собрать урожай" />
    <bpmn:task id="Task_ConfirmHarvest" name="Взвесить и подтвердить количество урожая" />
    <bpmn:task id="Task_CreateHarvestReport" name="Создать электронный отчёт об урожае" />
    <bpmn:task id="Task_RegisterHarvest" name="Зарегистрировать урожай по культурам и партиям" />
    <bpmn:task id="Task_UpdateHarvestStock" name="Обновить остатки готовой продукции на складе" />
    <bpmn:task id="Task_CreateSaleRequest" name="Создать заявку на продажу продукции" />
    <bpmn:task id="Task_ApproveSale" name="Утвердить цену и объём продажи" />
    <bpmn:task id="Task_RegisterSaleRequest" name="Зарегистрировать заказ покупателя" />
    <bpmn:task id="Task_CheckSaleDocs" name="Проверить реквизиты и комплект документов" />
    <bpmn:task id="Task_GenerateSaleDocs" name="Сформировать электронный договор, счёт и накладную" />
    <bpmn:task id="Task_SendOffer" name="Направить покупателю предложение и документы">
      <bpmn:outgoing>Flow_1f7rmc2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveOffer" name="Получить предложение и подтвердить заказ">
      <bpmn:incoming>Flow_1f7rmc2</bpmn:incoming>
      <bpmn:outgoing>Flow_14gxzmd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShipProduct" name="Отгрузить продукцию и передать документы">
      <bpmn:incoming>Flow_14gxzmd</bpmn:incoming>
      <bpmn:outgoing>Flow_0znvd9q</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveProduct" name="Получить продукцию и документы">
      <bpmn:incoming>Flow_0znvd9q</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_ArchiveDocs" name="Сохранить документы в электронном архиве и закрыть процесс" />
    <bpmn:endEvent id="End_Process" name="Продажа завершена" />
    <bpmn:task id="Task_ApprovePurchase" name="Рассмотреть и согласовать заявку" />
    <bpmn:task id="Task_CreatePurchaseRequest" name="Создать электронную заявку на закупку" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Season" targetRef="Task_CreatePlan" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_CreatePlan" targetRef="Task_ApprovePlan" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_ApprovePlan" targetRef="Task_RegisterPlan" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_RegisterPlan" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_CheckStock" targetRef="Gateway_EnoughResources" />
    <bpmn:sequenceFlow id="F06_yes" name="Да" sourceRef="Gateway_EnoughResources" targetRef="Task_PlanFieldWork" />
    <bpmn:sequenceFlow id="F06_no" name="Нет" sourceRef="Gateway_EnoughResources" targetRef="Task_CreatePurchaseRequest" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_CreatePurchaseRequest" targetRef="Task_RegisterPurchaseRequest" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_RegisterPurchaseRequest" targetRef="Task_ApprovePurchase" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_ApprovePurchase" targetRef="Gateway_PurchaseApproved" />
    <bpmn:sequenceFlow id="F10_yes" name="Да" sourceRef="Gateway_PurchaseApproved" targetRef="Task_GenerateOrder" />
    <bpmn:sequenceFlow id="F10_no" name="Нет" sourceRef="Gateway_PurchaseApproved" targetRef="Task_CreatePurchaseRequest" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_GenerateOrder" targetRef="Task_SendOrder" />
    <bpmn:sequenceFlow id="Flow_1y7zecu" name="Электронный заказ" sourceRef="Task_SendOrder" targetRef="Task_ReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_1eetfak" name="Поставка ресурсов" sourceRef="Task_DeliverResources" targetRef="Task_ReceiveDelivery" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_ReceiveDelivery" targetRef="Task_ConfirmAcceptance" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ConfirmAcceptance" targetRef="Task_RegisterAcceptance" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_RegisterAcceptance" targetRef="Task_UpdateStock" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_UpdateStock" targetRef="Task_PlanFieldWork" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_PlanFieldWork" targetRef="Task_PerformFieldWork" />
    <bpmn:sequenceFlow id="F20_no" name="Нет" sourceRef="Gateway_CropsReady" targetRef="Task_PerformFieldWork" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_PerformFieldWork" targetRef="Task_RegisterWork" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_RegisterWork" targetRef="Task_ControlCrops" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_ControlCrops" targetRef="Gateway_CropsReady" />
    <bpmn:sequenceFlow id="F20_yes" name="Да" sourceRef="Gateway_CropsReady" targetRef="Task_Harvest" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Harvest" targetRef="Task_ConfirmHarvest" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ConfirmHarvest" targetRef="Task_CreateHarvestReport" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_CreateHarvestReport" targetRef="Task_RegisterHarvest" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_RegisterHarvest" targetRef="Task_UpdateHarvestStock" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_UpdateHarvestStock" targetRef="Task_CreateSaleRequest" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_CreateSaleRequest" targetRef="Task_ApproveSale" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_ApproveSale" targetRef="Task_RegisterSaleRequest" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_RegisterSaleRequest" targetRef="Task_CheckSaleDocs" />
    <bpmn:sequenceFlow id="F29" sourceRef="Task_CheckSaleDocs" targetRef="Task_GenerateSaleDocs" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_GenerateSaleDocs" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="Flow_1f7rmc2" name="Предложение о продаже" sourceRef="Task_SendOffer" targetRef="Task_ReceiveOffer" />
    <bpmn:sequenceFlow id="Flow_14gxzmd" name="Подтверждение заказа" sourceRef="Task_ReceiveOffer" targetRef="Task_ShipProduct" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_ShipProduct" targetRef="Task_ArchiveDocs" />
    <bpmn:sequenceFlow id="Flow_0znvd9q" name="Отгрузка продукции" sourceRef="Task_ShipProduct" targetRef="Task_ReceiveProduct" />
    <bpmn:sequenceFlow id="F32" sourceRef="Task_ArchiveDocs" targetRef="End_Process" />
  </bpmn:process>
  <bpmn:process id="Process_Supplier" name="Обработка заказа поставщиком" isExecutable="false">
    <bpmn:sequenceFlow id="Supplier_F1" sourceRef="Task_ReceiveOrder" targetRef="Task_DeliverResources" />
  </bpmn:process>
  <bpmn:process id="Process_Buyer" name="Получение продукции покупателем" isExecutable="false">
    <bpmn:sequenceFlow id="Buyer_F1" sourceRef="Task_ReceiveOffer" targetRef="Task_ReceiveProduct" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Farm">
    <bpmndi:BPMNPlane id="BPMNPlane_Farm" bpmnElement="Collaboration_Farm">
      <bpmndi:BPMNShape id="Shape_Participant_Farm" bpmnElement="Participant_Farm" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="6500" height="1080" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Accountant" bpmnElement="Lane_Accountant" isHorizontal="true">
        <dc:Bounds x="190" y="890" width="6470" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Storekeeper" bpmnElement="Lane_Storekeeper" isHorizontal="true">
        <dc:Bounds x="190" y="740" width="6470" height="150" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Worker" bpmnElement="Lane_Worker" isHorizontal="true">
        <dc:Bounds x="190" y="590" width="6470" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="400" width="6470" height="190" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Agronomist" bpmnElement="Lane_Agronomist" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="6470" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Manager" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="6470" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Start_Season" bpmnElement="Start_Season">
        <dc:Bounds x="230" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="210" y="166" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_CreatePlan" bpmnElement="Task_CreatePlan">
        <dc:Bounds x="300" y="270" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ApprovePlan" bpmnElement="Task_ApprovePlan">
        <dc:Bounds x="470" y="120" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RegisterPlan" bpmnElement="Task_RegisterPlan">
        <dc:Bounds x="640" y="440" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_CheckStock" bpmnElement="Task_CheckStock">
        <dc:Bounds x="820" y="270" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_EnoughResources" bpmnElement="Gateway_EnoughResources" isMarkerVisible="true">
        <dc:Bounds x="1010" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1003" y="335" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RegisterPurchaseRequest" bpmnElement="Task_RegisterPurchaseRequest">
        <dc:Bounds x="1295" y="440" width="165" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_PurchaseApproved" bpmnElement="Gateway_PurchaseApproved" isMarkerVisible="true">
        <dc:Bounds x="1675" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1665" y="97.5" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_GenerateOrder" bpmnElement="Task_GenerateOrder">
        <dc:Bounds x="1760" y="440" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_SendOrder" bpmnElement="Task_SendOrder">
        <dc:Bounds x="1940" y="930" width="145" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceiveOrder" bpmnElement="Task_ReceiveOrder">
        <dc:Bounds x="1960" y="1215" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DeliverResources" bpmnElement="Task_DeliverResources">
        <dc:Bounds x="2170" y="1215" width="160" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ReceiveDelivery" bpmnElement="Task_ReceiveDelivery">
        <dc:Bounds x="2300" y="780" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ConfirmAcceptance" bpmnElement="Task_ConfirmAcceptance">
        <dc:Bounds x="2480" y="780" width="150" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RegisterAcceptance" bpmnElement="Task_RegisterAcceptance">
        <dc:Bounds x="2660" y="440" width="160" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_UpdateStock" bpmnElement="Task_UpdateStock">
        <dc:Bounds x="2850" y="440" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_PlanFieldWork" bpmnElement="Task_PlanFieldWork">
        <dc:Bounds x="3050" y="270" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_PerformFieldWork" bpmnElement="Task_PerformFieldWork">
        <dc:Bounds x="3240" y="630" width="165" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RegisterWork" bpmnElement="Task_RegisterWork">
        <dc:Bounds x="3440" y="440" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ControlCrops" bpmnElement="Task_ControlCrops">
        <dc:Bounds x="3630" y="270" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_CropsReady" bpmnElement="Gateway_CropsReady" isMarkerVisible="true">
        <dc:Bounds x="3810" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3797" y="335" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Harvest" bpmnElement="Task_Harvest">
        <dc:Bounds x="3910" y="630" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ConfirmHarvest" bpmnElement="Task_ConfirmHarvest">
        <dc:Bounds x="4080" y="780" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_CreateHarvestReport" bpmnElement="Task_CreateHarvestReport">
        <dc:Bounds x="4260" y="270" width="160" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RegisterHarvest" bpmnElement="Task_RegisterHarvest">
        <dc:Bounds x="4450" y="440" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_UpdateHarvestStock" bpmnElement="Task_UpdateHarvestStock">
        <dc:Bounds x="4640" y="440" width="165" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_CreateSaleRequest" bpmnElement="Task_CreateSaleRequest">
        <dc:Bounds x="4840" y="270" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ApproveSale" bpmnElement="Task_ApproveSale">
        <dc:Bounds x="5030" y="120" width="145" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RegisterSaleRequest" bpmnElement="Task_RegisterSaleRequest">
        <dc:Bounds x="5210" y="440" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_CheckSaleDocs" bpmnElement="Task_CheckSaleDocs">
        <dc:Bounds x="5400" y="930" width="150" height="70" />
