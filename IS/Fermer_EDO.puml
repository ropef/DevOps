@startuml
title Согласование электронной заявки на закупку (ЭДО)
autonumber


actor "Агроном" as Agronom
boundary "Интерфейс системы" as UI
control "Модуль ЭДО" as EDO
database "База данных" as DB
actor "Руководитель" as Manager
control "Складской модуль" as Stock

Agronom -> UI : Создать заявку на закупку
UI -> EDO : Передать данные заявки
EDO -> EDO : Проверить заполнение обязательных полей

alt Данные заполнены корректно
  EDO -> DB : Сохранить заявку
  DB --> EDO : Заявка сохранена
  EDO -> EDO : Присвоить номер и статус «На согласовании»
  EDO -> Manager : Отправить уведомление
  Manager -> UI : Открыть заявку и проверить данные
  UI -> EDO : Передать решение руководителя

  alt Заявка согласована
    EDO -> DB : Сохранить решение и статус «Согласована»
    EDO -> Stock : Передать заявку для оформления закупки
    Stock --> EDO : Подтверждение получения
    EDO --> UI : Показать статус «Согласована»
    UI --> Agronom : Уведомление о согласовании
  else Заявка отклонена
    EDO -> DB : Сохранить комментарий и статус «Отклонена»
    EDO --> UI : Показать причину отказа
    UI --> Agronom : Вернуть заявку на доработку
  end

else Есть ошибки заполнения
  EDO --> UI : Показать список ошибок
  UI --> Agronom : Запросить исправление данных
end
@enduml